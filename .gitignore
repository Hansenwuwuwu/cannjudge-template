# 凭证：仓库外保存，绝不提交
.cannjudge/
cookie.txt
user_id.txt
*.cookie

# 本地比赛配置（示例文件进仓库，实际配置不进）
prepare/contest.json
prepare/remote/config.json

# 提交结果与原始响应（本地保留，按需再决定是否入库）
prepare/submit/results/*.json
prepare/submit/results/last_submission.json
!prepare/submit/results/.gitkeep

# 远端包（含题目输入数据，用时自己打）
prepare/remote/assets.tar.gz
assets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini

# 比赛工程的构建产物（code/ 内部常见）
code/build/
code/out/
code/**/CMakeFiles/
code/**/CMakeCache.txt
code/**/*.o
code/**/*.so
